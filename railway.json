{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build:railway",
    "watchPatterns": ["server/**", "prisma/**"]
  },
  "deploy": {
    "startCommand": "npm --prefix server run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
